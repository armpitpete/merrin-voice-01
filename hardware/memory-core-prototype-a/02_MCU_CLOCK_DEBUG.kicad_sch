	(text "STM32H743VIT6 • 24.576 MHz HSE BYPASS • SAI1 TDM • I²C1 • SWD"
		(exclude_from_sim no)
		(at 20.32 17.78 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "cca6dd08-2e82-4a5c-83d2-4c4ff8cd42de")
	)
	(text "HSE bypass mode: U11 drives PH0-OSC_IN through R200; PH1-OSC_OUT is explicitly unused.\n24.576 MHz is within the STM32H743 4–48 MHz external HSE range."
		(exclude_from_sim no)
		(at 40.64 147.32 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "72e3fe22-748e-4987-aad9-314647bea208")
	)
	(text "All unused LQFP-100 GPIOs are explicitly no-connect.\nThe accepted allocation is encoded by physical pin number, not symbol position."
		(exclude_from_sim no)
		(at 259.08 216.66 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ddd21cff-8702-4c8b-8a98-98e0747cec17")
	)
	(text "U10 and U11 footprints intentionally blank. Final decoupling placement, oscillator part,\nLQFP land pattern and SWD connector remain footprint/mechanical gate items."
		(exclude_from_sim no)
		(at 40.64 266.7 0.0000)
