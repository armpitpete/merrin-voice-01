	(text "SHARED DEVICE CONTRACT\nU60 unit 1 = Memory (2 IIN1, 3 VC1, 4 IOUT1).\nU60 unit 2 = Ghost (7 IIN2, 6 VC2, 5 IOUT2).\nU60 unit 4 = wet master (10 IIN4, 11 VC4, 12 IOUT4).\nU60 units 3 and 5 remain on sheet 06; no second SSI2164 is created.\nU63 OPA4196 units 1/2/4 buffer Memory/Ghost/Wet; units 3/5 remain on sheet 06."
		(exclude_from_sim no)
		(at 40.64 190.5 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "217133ca-5e21-47b5-a602-4fbb465d491a")
	)
	(text "WET SUM CONTRACT\nR510 = R511 = 40.2k; R512 = 20.0k.\nEach branch magnitude = 0.4975; two equal full-scale branches ~= 0.995 total.\nVCA controls are bounded and fail-safe-selected on sheet 08; sheet 05 adds isolation/filtering only."
		(exclude_from_sim no)
		(at 218.44 205.74 0.0000)
		(effects
			(font
				(size 1.1 1.1)
			)
		)
		(uuid "23bc54b1-33c1-4f30-a074-0594c9e4428d")
	)
	(text "BOUNDARY\nMemory, Ghost, wet-sum, SSI current nodes and controls remain local.\nOnly WET_MIX crosses the sheet-05 hierarchy boundary."
		(exclude_from_sim no)
		(at 218.44 246.38 0.0000)
