	(text "03 — CODEC / CONVERSION"
		(exclude_from_sim no)
		(at 20.32 12.7 0.0000)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "9fc047b0-3987-4f3a-a993-55f69f7aba48")
	)
	(text "PCM3168A • DIFFERENTIAL ADC INGRESS • MEMORY / GHOST / RETURN DAC FILTERS"
		(exclude_from_sim no)
		(at 20.32 17.78 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "813fcb25-56dd-4fdb-b84e-74d0a4a816c0")
	)
	(text "ADC gain contract: each phase = ±ADC_ANALOG_IN / 3.\n2 Vpp nominal → 1.333 Vpp differential ≈ −12.6 dBFS; 6 Vpp → 4 Vpp differential ≈ −3.0 dBFS."
		(exclude_from_sim no)
		(at 45.72 228.6 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "37abbf9b-6a2b-4bf4-a8a9-bc92bbe89fbd")
	)
	(text "DAC filters follow TI Figure 61 nominal values: R1 7.5k, R2 5.6k, R3 360R, C1 3.3nF, C2 680pF, gain ≈ 0.747, f−3dB ≈ 53kHz."
		(exclude_from_sim no)
		(at 220.98 228.6 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "300de5ab-e3b2-4498-9c3d-9152aba9ca42")
	)
	(text "ADC2–6 differential pins are paired and AC-terminated to AGND; DAC4–8 and DOUT2/3 are explicit no-connects.\nFirmware keeps inactive channels muted/power-save. VCOM/VREF are local decoupling references only."
		(exclude_from_sim no)
		(at 45.72 266.7 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a9998381-560b-4cab-9e09-1d7da4976658")
	)
	(text "CODEC_MUTE_N is a hard reset/power-down request through the diode AND gate.\nPCM soft mute remains I²C-controlled; external SSI2164 attenuation remains the primary wet/Return safety clamp."
		(exclude_from_sim no)
		(at 220.98 251.46 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c7afd8e6-e117-4113-aa89-149756417796")
	)
