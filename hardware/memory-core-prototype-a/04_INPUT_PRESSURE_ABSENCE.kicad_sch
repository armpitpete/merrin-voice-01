	)
	(text "SWITCHED INPUT • QUIET NO-CABLE STATE • DIRECT PRESENT • PRESSURE • ABSENCE • MEMORY SUM"
		(exclude_from_sim no)
		(at 20.32 17.78 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "51aa312d-4c66-4fee-8fbe-05f872757f6d")
	)
	(text "No cable: J40 TIP normal contact grounds the input before protection.\nPlug insertion opens the normal contact and admits the external signal."
		(exclude_from_sim no)
		(at 40.64 203.2 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8a9cd13d-4df9-481c-962c-c303e8b21075")
	)
	(text "DIRECT_PRESENT splits after protected AC-coupled unity buffering and before Pressure/Absence.\nSHAPED_PRESENT contains Pressure plus Return-derived Absence attenuation."
		(exclude_from_sim no)
		(at 40.64 218.44 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3e9459ac-dca0-435c-9344-8d2a6f024191")
	)
	(text "ADC_ANALOG_IN = -(SHAPED_PRESENT + RETURN_FEED), unity per input.\nThe inverting sum restores the accepted feedback polarity from the inverting sheet-06 feed."
		(exclude_from_sim no)
		(at 40.64 233.68 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "29e29806-d3e5-4d26-bd48-74df2d402d94")
	)
	(text "J40/Q40/U40/U41 and diode footprints intentionally blank. JFET VGS(off), jack pin map,\nPressure thresholds, Absence law, input surge behaviour and complete loop gain remain gates."
		(exclude_from_sim no)
		(at 40.64 269.24 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "cfe4dbe2-4db5-4cf5-b9a8-4796a0527b97")
	)
