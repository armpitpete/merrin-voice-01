	)
	(text "Clamp references +/-2.5 V plus Schottky Vf give approximately 5.4-5.6 Vpp RETURN_LIMITED.\nFixed feed magnitude = 27.4k / 40.2k = 0.6816; 1% worst case < 0.696."
		(exclude_from_sim no)
		(at 40.64 218.44 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
