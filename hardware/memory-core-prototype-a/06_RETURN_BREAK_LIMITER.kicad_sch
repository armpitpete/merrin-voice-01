	(text "06 — RETURN / BREAK / LIMITER"
		(exclude_from_sim no)
		(at 20.32 12.7 0.0000)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "08e7ca99-2b0b-44a6-bb31-5902a2dfe512")
	)
	(text "SSI2164 CH3 • VARIABLE BREAK • UNITY-NORMALISED RETURN • INDEPENDENT ANALOGUE CLAMP"
		(exclude_from_sim no)
		(at 20.32 17.78 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c6e5bcf4-4120-47ec-9648-9223beea7020")
	)
	(text "GAIN CONTRACT\nsheet-03 Return receiver ~0.747; R600/R601 = 1/3; combined ~0.249.\nSSI2164 VC3 is restricted to 0…3.3 V, so VCA gain cannot exceed unity.\nBreak and RET-01 are unity at small signal; nonlinear branches alter shape, not linear gain."
		(exclude_from_sim no)
		(at 40.64 190.5 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f6129f72-6ff6-4fe8-855f-7e0972cb6a90")
	)
	(text "HARD LIMITER\nR624 limits clamp current. D607/D608 clamp to buffered +/-2.5 V references.\nExpected first-pass limit ~+/-2.7…2.8 V. Limiter remains analogue and MCU-independent."
		(exclude_from_sim no)
		(at 40.64 228.6 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2d56bd44-d1d8-4102-a710-8acbd6db23e5")
	)
	(text "FIXED FEED: 27.4k / 40.2k = 0.6816 nominal; 1% worst case <0.696.\nOnly RETURN_LIMITED, RETURN_FEED and ABSENCE_INFLUENCE cross this boundary."
		(exclude_from_sim no)
		(at 241.3 238.76 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f0425cf2-292e-4489-a4eb-45ab46502a5f")
	)
	(text "Official SSI2164 channel 3 pins: 15 IIN3, 14 VC3, 13 IOUT3.\nPins 10/11/12 are channel 4 and are reserved for the wet-master unit on sheet 05."
		(exclude_from_sim no)
		(at 241.3 261.62 0.0000)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bbdb0ed1-ea67-48be-89ab-c939b4584e7f")
	)
	(text "U60 units 1, 2 and 4 are visible staged reservations for sheet 05.\nThey are the same physical SSI2164 as units 3 and 5, not duplicate chips.\nSheet 05 must remove these reservations and place the real Memory/Ghost/Wet circuits."
		(exclude_from_sim no)
		(at 322.58 276.86 0.0000)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "49a0ef72-a12a-42ea-861b-fcfdd5c58319")
	)
