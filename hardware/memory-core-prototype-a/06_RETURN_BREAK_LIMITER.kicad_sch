	)
	(text "Small-signal path: SSI VCA <= unity; Break = -1; normaliser = -1.\nOnly RETURN_LIMITED, RETURN_FEED and bounded ABSENCE_INFLUENCE cross this sheet."
		(exclude_from_sim no)
		(at 40.64 233.68 0.0000)
