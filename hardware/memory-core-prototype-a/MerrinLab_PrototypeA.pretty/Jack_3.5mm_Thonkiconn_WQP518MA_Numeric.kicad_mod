    (effects (font (size 0.7 0.7) (thickness 0.1)))
  )
  (fp_text user "3 SLEEVE" (at 3 0 180) (layer F.Fab)
    (effects (font (size 0.7 0.7) (thickness 0.1)))
  )
  (fp_text user "3mm BARREL RELIEF" (at 0 6.48 90) (layer Cmts.User)
